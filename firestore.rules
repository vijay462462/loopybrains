rules_version = '2';
// Security rules for RGUKT Spark.
//
// HOW TO USE
//  1. Firebase console > Firestore Database > Rules. COPY YOUR CURRENT RULES SOMEWHERE SAFE FIRST.
//  2. Paste this file, then replace nothing: the room is matched generically ({room}) so the
//     private class code never appears in this public repository.
//  3. Click "Rules playground" and test a create on /rooms/TEST/doubts/abc with a sample post
//     before you publish. If a real action in the app is rejected, tell me the field name.
//
// WHAT THESE RULES DO
//  - Every collection the app uses is listed. Anything not listed is denied.
//  - Each document may only contain the known fields, with the right types and sizes.
//  - New posts must carry a current timestamp, can't start deleted or with reports.
//  - authorId and createdAt can never change after posting.
//  - Updates may only touch the fields the app really edits (quiz answers, authorId, createdAt and
//    the challenge questions can not be changed after posting).
//  - Nothing can be permanently deleted except your own like or reaction (website uses soft delete).
//
// ANONYMOUS SIGN-IN IS NOW ON: the app signs every browser in anonymously (no account, no password)
// and member() requires that session. ORDER MATTERS: 1) deploy the app (v154+), 2) Firebase console >
// Authentication > Sign-in method > enable Anonymous, 3) only then publish these rules. Publishing
// them earlier locks out everyone. To roll back, change member() to `return true;`.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function member() { return signedIn(); }
    // Device block list: an admin adds a document whose id is the device id to rooms/<room>/blocked in the console.
    function notBlocked(room, id) {
      return (!(id is string) || !exists(/databases/$(database)/documents/rooms/$(room)/blocked/$(id))) && globalVerified() && verifiedOk(room);
    }
    // Global switches (settings/posting, set by an admin): verifiedPosting = nobody posts without a verified email; strongAuth = nobody posts without a verified email AND a verified mobile number.
    function globalVerified() {
      return !exists(/databases/$(database)/documents/settings/posting)
        || ((get(/databases/$(database)/documents/settings/posting).data.get('verifiedPosting', false) != true || request.auth.token.email_verified == true)
            && (get(/databases/$(database)/documents/settings/posting).data.get('strongAuth', false) != true
                || (request.auth.token.email_verified == true && request.auth.token.get('phone_number', '') != '')));
    }
    // Boards of directory colleges live in the room 'college-<slug>'. If colleges/<slug> says requireVerified, only signed-in
    // users with a verified email (from one of its `domains`, when listed) may write. Everyone can still read.
    function collegeSlug(room) { return room.matches('college-.+') ? room.split('college-')[1] : ''; }
    function verifiedOk(room) {
      let slug = collegeSlug(room);
      return slug == '' || !exists(/databases/$(database)/documents/colleges/$(slug))
        || get(/databases/$(database)/documents/colleges/$(slug)).data.get('requireVerified', false) != true
        || (request.auth.token.email_verified == true
            && (get(/databases/$(database)/documents/colleges/$(slug)).data.get('domains', []).size() == 0
                || request.auth.token.email.split('@')[1] in get(/databases/$(database)/documents/colleges/$(slug)).data.get('domains', [])));
    }

    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optBool(d, k) { return !(k in d) || d[k] is bool; }
    function optList(d, k, n) { return !(k in d) || (d[k] is list && d[k].size() <= n); }
    function recent(t) { return t is int && t > request.time.toMillis() - 1800000 && t < request.time.toMillis() + 1800000; }
    function unchanged() {
      return request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    function changes(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- posts: doubts, ideas, clubs, gate, challenges ----------
    // g is the field that holds the subject / category / club / type.
    function validPost(g) {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'body', g, 'authorId', 'authorName', 'anonymous', 'urgent', 'createdAt',
                               'pages', 'fileAttachments', 'year', 'tags', 'pyqYear', 'marks', 'difficulty',
                               'resolvedReplyId', 'bounty', 'campus', 'chalType', 'timeLimit', 'questions', 'status',
                               'winner', 'winnerName', 'runnerUp', 'runnerUpName', 'deleted', 'reports', 'editedAt',
                               'company', 'applyUrl', 'deadline', 'pay', 'ownerUid', 'aud', 'to', 'via', 'viaSlug', 'viaOf', 'sentTo', 'ansPrivate', 'dupOf'])
        && optStr(d, 'ownerUid', 60) && str(d.title, 3, 200) && str(d.body, 0, 5000) && str(d[g], 1, 60)
        && str(d.authorName, 1, 40) && str(d.authorId, 8, 80) && d.createdAt is int
        && optBool(d, 'anonymous') && optBool(d, 'urgent') && optBool(d, 'bounty') && optBool(d, 'deleted') && optBool(d, 'ansPrivate') && optStr(d, 'dupOf', 100)
        && optList(d, 'pages', 5) && optList(d, 'fileAttachments', 5) && optList(d, 'reports', 100)
        && optList(d, 'questions', 10)
        && optStr(d, 'year', 12) && optStr(d, 'tags', 100) && optStr(d, 'pyqYear', 20) && optStr(d, 'marks', 4)
        && optStr(d, 'difficulty', 10) && optStr(d, 'campus', 30) && optStr(d, 'chalType', 20)
        && optStr(d, 'aud', 8) && optStr(d, 'via', 80) && optStr(d, 'viaSlug', 40) && optStr(d, 'viaOf', 100) && optList(d, 'sentTo', 3) && optList(d, 'to', 4)
        && optStr(d, 'company', 60) && optStr(d, 'applyUrl', 300) && optStr(d, 'deadline', 10) && optStr(d, 'pay', 40)
        && optStr(d, 'winner', 100) && optStr(d, 'winnerName', 40) && optStr(d, 'runnerUp', 100) && optStr(d, 'runnerUpName', 40)
        && (!('timeLimit' in d) || (d.timeLimit is number && d.timeLimit >= 0 && d.timeLimit <= 180))
        && (!('status' in d) || d.status in ['open', 'closed'])
        && (!('editedAt' in d) || d.editedAt is int)
        && (!('resolvedReplyId' in d) || d.resolvedReplyId == null || str(d.resolvedReplyId, 1, 100));
    }
    function newPost(g) {
      let d = request.resource.data;
      return validPost(g) && recent(d.createdAt) && d.get('deleted', false) == false && !('reports' in d);
    }
    // Fields a post update may change. Questions, authorId and createdAt are fixed after posting.
    function postEdit(g) {
      return changes(['title', 'body', g, 'authorName', 'anonymous', 'urgent', 'pages', 'fileAttachments', 'year',
                      'tags', 'editedAt', 'deleted', 'reports', 'resolvedReplyId', 'bounty', 'status',
                      'winner', 'winnerName', 'runnerUp', 'runnerUpName', 'pyqYear', 'marks', 'difficulty', 'campus', 'company', 'applyUrl', 'deadline', 'pay', 'dupOf']);
    }

    // ---------- market listings ----------
    function validListing() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'body', 'category', 'price', 'condition', 'whatsapp', 'authorId', 'authorName',
                               'sold', 'createdAt', 'campus', 'deleted', 'reports', 'ownerUid'])
        && optStr(d, 'ownerUid', 60) && str(d.title, 3, 200) && str(d.body, 0, 2000) && str(d.category, 1, 40)
        && (d.price == null || (d.price is number && d.price >= 0 && d.price <= 10000000))
        && optStr(d, 'condition', 40) && optStr(d, 'whatsapp', 10) && optStr(d, 'campus', 30)
        && str(d.authorName, 1, 40) && str(d.authorId, 8, 80) && d.createdAt is int
        && optBool(d, 'sold') && optBool(d, 'deleted') && optList(d, 'reports', 100);
    }

    // College setup. Public read so the page can load a college before anyone signs in; only the console writes.
    match /colleges/{slug} {
      allow read: if true;
      allow create, update: if isAdmin() && validCollege() && slug.matches('[a-z0-9-]{2,40}');
      allow delete: if false;
    }
    // "Add my college" requests: anyone signed in can send one, only the owner reads them in the console.
    match /collegeRequests/{id} {
      allow read: if isAdmin();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['name', 'city', 'role', 'contact', 'consent', 'createdAt'])
        && str(request.resource.data.name, 3, 80) && request.resource.data.get('city', '') is string && request.resource.data.get('city', '').size() <= 60
        && request.resource.data.get('role', '') is string && request.resource.data.get('role', '').size() <= 30
        && request.resource.data.get('contact', '') is string && request.resource.data.get('contact', '').size() <= 100
        && request.resource.data.consent == true && recent(request.resource.data.createdAt);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- admin ----------
    // An admin is a signed-in user with a verified email whose auth id has a document in `admins`
    // (create it by hand in the Firebase console; nobody can create it from the app).
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Moderation by an admin: hide or restore something, or clear its reports. Nothing else can change.
    // College staff: a global admin adds a document staff/<room>_<uid>. Staff can manage ONLY that college's room:
    // hide/restore posts, block devices, post notices and papers. They cannot touch colleges, promos, sales or other rooms.
    function isStaff(room) {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staff/$(room + '_' + request.auth.uid));
    }
    function staffMod(room) {
      return isStaff(room) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'reports'])
        && request.resource.data.get('deleted', false) is bool;
    }
    function adminMod() {
      return isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'reports'])
        && request.resource.data.get('deleted', false) is bool;
    }
    // Ownership: new posts, replies, stories and listings carry ownerUid (the author's sign-in id). Only that user may edit
    // or hide them; anyone may add a report. Older items without ownerUid stay editable as before.
    function ownerOk(d) { return !('ownerUid' in d) || d.ownerUid == request.auth.uid; }
    function isOwner() { return resource.data.get('ownerUid', '') == '' || resource.data.ownerUid == request.auth.uid; }
    function sameOwner() { return request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', ''); }
    function reportOnly() {
      return request.auth != null && sameOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports'])
        && request.resource.data.reports is list
        && request.resource.data.reports.size() <= resource.data.get('reports', []).size() + 1
        && request.resource.data.reports.hasAll(resource.data.get('reports', []));
    }
    function validCollege() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'title', 'tagline', 'room', 'city', 'state', 'captions', 'campuses', 'subjects', 'departments',
                               'clubs', 'ideaCategories', 'exams', 'accent', 'crest', 'features', 'domains', 'requireVerified', 'listed', 'enabled', 'updatedAt'])
        && optStr(d, 'crest', 60000) && (!('crest' in d) || d.crest == '' || d.crest.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+'))
        && str(d.name, 3, 60) && d.room is string && d.room.matches('[A-Za-z0-9_-]{6,40}')
        && optStr(d, 'title', 40) && optStr(d, 'tagline', 80) && optStr(d, 'city', 40) && optStr(d, 'state', 50) && optStr(d, 'accent', 7)
        && optList(d, 'captions', 10) && optList(d, 'campuses', 12) && optList(d, 'subjects', 80) && optList(d, 'clubs', 30)
        && optList(d, 'ideaCategories', 20) && optList(d, 'exams', 12) && optList(d, 'domains', 8)
        && optBool(d, 'requireVerified') && optBool(d, 'listed') && optBool(d, 'enabled');
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Everything an admin does is written here (create only, so it cannot be edited afterwards).
    match /adminLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['by', 'action', 'target', 'room', 'note', 'at'])
        && str(request.resource.data.action, 1, 60) && request.resource.data.at is int
        && request.resource.data.get('target', '') is string && request.resource.data.get('target', '').size() <= 200
        && request.resource.data.get('room', '') is string && request.resource.data.get('room', '').size() <= 60
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300;
      allow update, delete: if false;
    }

    // CampusLoop Plus. entitlements/<uid> is written only by the payment server (admin access ignores these rules).
    function plusActive(uid) {
      return exists(/databases/$(database)/documents/entitlements/$(uid))
        && get(/databases/$(database)/documents/entitlements/$(uid)).data.until > request.time.toMillis();
    }
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Private cloud backup of the study tools. Needs a verified email; when config/plus.required is true it also needs an active Plus plan.
    match /userData/{uid} {
      function backupAllowed() {
        return !(exists(/databases/$(database)/documents/config/plus)
                 && get(/databases/$(database)/documents/config/plus).data.get('required', false) == true) || plusActive(uid);
      }
      allow read: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true && backupAllowed();
      allow create, update: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true && backupAllowed()
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && str(request.resource.data.json, 2, 900000) && request.resource.data.updatedAt is int;
      allow delete: if false;
    }
    match /config/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // Weekly report e-mail settings: one document per college, admins only (it holds the private room id and e-mail addresses).
    match /reportEmails/{slug} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && slug.matches('[a-z0-9-]{2,40}') && request.resource.data.keys().hasOnly(['room', 'name', 'emails', 'active', 'updatedAt', 'lastSent'])
        && request.resource.data.room.matches('[A-Za-z0-9_-]{6,40}') && str(request.resource.data.name, 1, 60)
        && request.resource.data.emails is list && request.resource.data.emails.size() <= 5
        && request.resource.data.active is bool && request.resource.data.updatedAt is int;
      allow delete: if isAdmin();
    }
    // College bundle: licenses/<slug> is the private record (admins only); collegePlus/<slug> is the public switch the app reads
    // ("this college's students get Plus until <date>").
    match /licenses/{slug} {
      allow read, write: if isAdmin() && slug.matches('[a-z0-9-]{2,40}') && (request.method == 'delete' || (
        request.resource.data.keys().hasOnly(['name', 'seats', 'pricePerStudent', 'amount', 'startAt', 'until', 'contact', 'notes', 'updatedAt'])
        && str(request.resource.data.name, 1, 60) && request.resource.data.seats is int && request.resource.data.seats >= 0
        && request.resource.data.until is int && request.resource.data.startAt is int && request.resource.data.updatedAt is int
        && optStr(request.resource.data, 'contact', 120) && optStr(request.resource.data, 'notes', 300)));
    }
    match /collegePlus/{slug} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && slug.matches('[a-z0-9-]{2,40}') && request.resource.data.keys().hasOnly(['name', 'until', 'updatedAt'])
        && str(request.resource.data.name, 1, 60) && request.resource.data.until is int && request.resource.data.updatedAt is int;
      allow delete: if isAdmin();
    }
    // Staff roster: only global admins write it; a staff member can read their own entries (to see which college they manage).
    match /staff/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['uid', 'room', 'slug', 'name', 'label', 'by', 'createdAt'])
        && str(request.resource.data.uid, 10, 128) && request.resource.data.room.matches('[A-Za-z0-9_-]{6,40}')
        && id == request.resource.data.room + '_' + request.resource.data.uid
        && str(request.resource.data.name, 1, 60) && optStr(request.resource.data, 'label', 40) && request.resource.data.createdAt is int;
      allow delete: if isAdmin();
    }
    // App-wide settings. Everyone signed in can read (the app needs to know if posting needs a verified email); only admins write.
    match /settings/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && id == 'posting' && request.resource.data.keys().hasOnly(['verifiedPosting', 'strongAuth', 'updatedAt'])
        && request.resource.data.verifiedPosting is bool && request.resource.data.get('strongAuth', false) is bool && request.resource.data.updatedAt is int;
      allow delete: if false;
    }
    // Flash sale banner: one document, sales/current. Everyone signed in reads it; only admins change it.
    match /sales/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && id == 'current' && request.resource.data.keys().hasOnly(['title', 'text', 'code', 'until', 'active', 'updatedAt'])
        && str(request.resource.data.title, 3, 60) && str(request.resource.data.text, 0, 160)
        && (!('code' in request.resource.data) || request.resource.data.code == '' || request.resource.data.code.matches('[A-Z0-9]{3,20}'))
        && request.resource.data.until is int && request.resource.data.active is bool && request.resource.data.updatedAt is int;
      allow delete: if false;
    }
    // Promo codes: admins create them in the dashboard; the payment server checks and counts them.
    match /promoCodes/{code} {
      function validPromo() {
        let d = request.resource.data;
        return d.keys().hasOnly(['percent', 'plan', 'until', 'maxUses', 'used', 'active', 'note', 'createdAt'])
          && d.percent is int && d.percent >= 5 && d.percent <= 90 && d.plan in ['any', 'weekly', 'monthly', 'semester', 'yearly']
          && d.until is int && d.maxUses is int && d.maxUses >= 1 && d.maxUses <= 100000 && d.used == 0 && d.active is bool
          && optStr(d, 'note', 100) && d.createdAt is int;
      }
      allow read: if isAdmin();
      allow create: if isAdmin() && code.matches('[A-Z0-9]{3,20}') && validPromo();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'until', 'maxUses']);
      allow delete: if isAdmin();
    }
    // Referral codes: a student registers their own code (the first 10 characters of their sign-in id) so friends can use it.
    // Only the server reads these and gives the rewards.
    match /refCodes/{code} {
      allow read: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && code == request.auth.uid[0:10] && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }
    // "Which Plus features would you pay for?" answers: anyone signed in can add one, only the owner reads them in the console.
    match /plusInterest/{id} {
      allow read: if isAdmin();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['email', 'college', 'features', 'price', 'createdAt'])
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 100
        && request.resource.data.get('college', '') is string && request.resource.data.get('college', '').size() <= 60
        && request.resource.data.features is list && request.resource.data.features.size() <= 10
        && str(request.resource.data.price, 1, 30) && recent(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    // College vs College weekly battle. A student's answer moves two documents in ONE batch: their own battlePlayers
    // counter and their college's battleColleges counter. The rules make sure both move together and by the same amount,
    // and cap one student at 70 right answers a week, so one student cannot inflate a college.
    function battleOk(after, before) {
      let pExists = exists(/databases/$(database)/documents/battlePlayers/$(after.week + '_' + request.auth.uid));
      let pb = pExists ? get(/databases/$(database)/documents/battlePlayers/$(after.week + '_' + request.auth.uid)).data : {'correct': 0, 'total': 0};
      let pa = getAfter(/databases/$(database)/documents/battlePlayers/$(after.week + '_' + request.auth.uid)).data;
      return pa.slug == after.slug && pa.week == after.week
        && after.correct - before.correct == pa.correct - pb.correct
        && after.total - before.total == pa.total - pb.total
        && after.players - before.players == (pExists ? 0 : 1);
    }
    match /battleColleges/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['week', 'slug', 'correct', 'total', 'players', 'updatedAt'])
        && str(request.resource.data.week, 2, 12) && str(request.resource.data.slug, 2, 40)
        && request.resource.data.correct is int && request.resource.data.total is int && request.resource.data.players is int
        && id == request.resource.data.week + '_' + request.resource.data.slug
        && (resource == null || (resource.data.week == request.resource.data.week && resource.data.slug == request.resource.data.slug))
        && battleOk(request.resource.data, resource == null ? {'correct': 0, 'total': 0, 'players': 0} : resource.data);
      allow delete: if false;
    }
    // Web-push tokens: a signed-in user stores only their OWN token document (id = their uid). Nobody can read tokens from the app;
    // only the server function that sends notifications can (it ignores these rules).
    // Loopy Brain daily credits. The document id is <uid>_<day number in India time>. Usage is saved in small batches: the count can only rise by up to 30 at a time, up to a hard ceiling, and only for today.
    match /searchUsage/{id} {
      allow read: if request.auth != null && id.matches(request.auth.uid + '_[0-9]+');
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['n', 'd', 'at'])
        && request.resource.data.d is int && request.resource.data.n is int && request.resource.data.at is int
        && id == request.auth.uid + '_' + string(request.resource.data.d)
        && request.resource.data.d * 86400000 <= request.time.toMillis() + 19800000
        && request.time.toMillis() + 19800000 < (request.resource.data.d + 1) * 86400000
        && request.resource.data.n >= 1 && request.resource.data.n <= 30;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['n', 'd', 'at'])
        && request.resource.data.d == resource.data.d && request.resource.data.n is int && request.resource.data.at is int
        && id == request.auth.uid + '_' + string(request.resource.data.d)
        && request.resource.data.d * 86400000 <= request.time.toMillis() + 19800000
        && request.time.toMillis() + 19800000 < (request.resource.data.d + 1) * 86400000
        && request.resource.data.n > resource.data.n && request.resource.data.n <= resource.data.n + 30 && request.resource.data.n <= 600;
      allow delete: if isAdmin();
    }

    // Loopy Brain weekly credits (week = Monday to Sunday, India time). Document id is <uid>_w<week number>. Same rules: only raise by one search, only this week, hard ceiling.
    match /searchWeek/{id} {
      allow read: if request.auth != null && id.matches(request.auth.uid + '_w[0-9]+');
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['n', 'w', 'at'])
        && request.resource.data.w is int && request.resource.data.n is int && request.resource.data.at is int
        && id == request.auth.uid + '_w' + string(request.resource.data.w)
        && (request.resource.data.w * 7 - 3) * 86400000 <= request.time.toMillis() + 19800000
        && request.time.toMillis() + 19800000 < (request.resource.data.w * 7 + 4) * 86400000
        && request.resource.data.n >= 1 && request.resource.data.n <= 30;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['n', 'w', 'at'])
        && request.resource.data.w == resource.data.w && request.resource.data.n is int && request.resource.data.at is int
        && id == request.auth.uid + '_w' + string(request.resource.data.w)
        && (request.resource.data.w * 7 - 3) * 86400000 <= request.time.toMillis() + 19800000
        && request.time.toMillis() + 19800000 < (request.resource.data.w * 7 + 4) * 86400000
        && request.resource.data.n > resource.data.n && request.resource.data.n <= resource.data.n + 30 && request.resource.data.n <= 3000;
      allow delete: if isAdmin();
    }

    // Loopy Search safety: strikes for sexual or romantic searches. Students can only add strikes (never lower them or undo a block); admins can review or remove.
    match /searchSafety/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['warns', 'blocked', 'at'])
        && request.resource.data.warns is int && request.resource.data.warns >= 1 && request.resource.data.warns <= 3
        && request.resource.data.blocked is bool && request.resource.data.at is int;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['warns', 'blocked', 'at'])
        && request.resource.data.warns is int && request.resource.data.warns >= resource.data.warns && request.resource.data.warns <= 3
        && request.resource.data.blocked is bool && (!resource.data.blocked || request.resource.data.blocked == true)
        && request.resource.data.at is int;
      allow delete: if isAdmin();
    }

    match /pushTokens/{uid} {
      allow get, list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokens', 'updatedAt'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() >= 1 && request.resource.data.tokens.size() <= 5
        && request.resource.data.tokens[0] is string && request.resource.data.tokens[0].size() >= 20 && request.resource.data.tokens[0].size() <= 400
        && request.resource.data.updatedAt is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Student IDs issued by the claimStudentId function. Students read only their own; admins can look any up. Nobody can write from the app.
    match /studentIds/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }
    match /idCounters/{id} { allow read, write: if false; }
    // Custom Loop IDs (@name). Each name is a document id, so two students can never hold the same one. A student may take a new name at most once
    // every 30 days (handleLog/<uid> is written in the same batch), may release their own name, and cannot take reserved or look-alike staff names.
    match /handleLog/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is int && recent(request.resource.data.at)
        && (resource == null || resource.data.at < request.time.toMillis() - 2592000000);
      allow delete: if false;
    }
    match /handles/{h} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && h.matches('[a-z0-9_]{3,15}') && !h.matches('(admin|official|support|staff|moderator|campusloop|loop|rgukt|help|team|mod)[a-z0-9_]*')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']) && request.resource.data.uid == request.auth.uid && recent(request.resource.data.createdAt)
        && getAfter(/databases/$(database)/documents/handleLog/$(request.auth.uid)).data.at == request.resource.data.createdAt;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Pilot feedback: one short form per student per week (document id = <uid>_<week>). Students can only add their own; only admins read it.
    match /pilotFeedback/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['week', 'uid', 'slug', 'rating', 'pay', 'liked', 'improve', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && str(request.resource.data.week, 2, 12) && str(request.resource.data.slug, 0, 40)
        && id == request.auth.uid + '_' + request.resource.data.week
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.pay in ['no', '29', '49', '99', 'later']
        && str(request.resource.data.liked, 0, 300) && str(request.resource.data.improve, 0, 300)
        && recent(request.resource.data.createdAt);
      allow update, delete: if false;
    }
    // Weekly Showdown (ideas and answers). Same idea as the quiz battle, with two extra locks: only a verified e-mail can score, and one student
    // is capped per week (5 ideas, 20 answers). A student's counter and their college's counter must move together by exactly 1.
    function showOk(after, before) {
      let pid = after.week + '_' + request.auth.uid + '_' + after.kind;
      let pExists = exists(/databases/$(database)/documents/showdownPlayers/$(pid));
      let pb = pExists ? get(/databases/$(database)/documents/showdownPlayers/$(pid)).data : {'n': 0};
      let pa = getAfter(/databases/$(database)/documents/showdownPlayers/$(pid)).data;
      return pa.slug == after.slug && pa.week == after.week && pa.kind == after.kind
        && after.n - before.n == pa.n - pb.n && after.n - before.n == 1
        && after.players - before.players == (pExists ? 0 : 1);
    }
    match /showdownColleges/{id} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['week', 'slug', 'kind', 'n', 'players', 'updatedAt'])
        && str(request.resource.data.week, 2, 12) && str(request.resource.data.slug, 2, 40) && request.resource.data.kind in ['idea', 'answer']
        && request.resource.data.n is int && request.resource.data.players is int && recent(request.resource.data.updatedAt)
        && id == request.resource.data.week + '_' + request.resource.data.slug + '_' + request.resource.data.kind
        && (resource == null || (resource.data.week == request.resource.data.week && resource.data.slug == request.resource.data.slug && resource.data.kind == request.resource.data.kind))
        && showOk(request.resource.data, resource == null ? {'n': 0, 'players': 0} : resource.data);
      allow delete: if false;
    }
    match /showdownPlayers/{id} {
      allow get: if request.auth != null && id.matches('.*_' + request.auth.uid + '_(idea|answer)');
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['week', 'uid', 'slug', 'kind', 'n', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.kind in ['idea', 'answer']
        && str(request.resource.data.week, 2, 12) && str(request.resource.data.slug, 2, 40)
        && id == request.resource.data.week + '_' + request.auth.uid + '_' + request.resource.data.kind
        && request.resource.data.n is int && request.resource.data.n >= 1
        && request.resource.data.n <= (request.resource.data.kind == 'idea' ? 5 : 20)
        && recent(request.resource.data.updatedAt)
        && (resource == null
            ? request.resource.data.n == 1
            : (resource.data.slug == request.resource.data.slug && resource.data.week == request.resource.data.week && resource.data.kind == request.resource.data.kind
               && request.resource.data.n == resource.data.n + 1));
      allow delete: if false;
    }
    match /battlePlayers/{id} {
      allow get: if request.auth != null && id.matches('.*_' + request.auth.uid);
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['week', 'uid', 'slug', 'correct', 'total', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.week, 2, 12) && str(request.resource.data.slug, 2, 40)
        && id == request.resource.data.week + '_' + request.auth.uid
        && request.resource.data.correct is int && request.resource.data.total is int
        && request.resource.data.correct >= 0 && request.resource.data.correct <= 70
        && request.resource.data.total <= 140 && request.resource.data.correct <= request.resource.data.total
        && recent(request.resource.data.updatedAt)
        && (resource == null
            ? (request.resource.data.total == 1)
            : (resource.data.slug == request.resource.data.slug && resource.data.week == request.resource.data.week
               && request.resource.data.total == resource.data.total + 1
               && (request.resource.data.correct == resource.data.correct || request.resource.data.correct == resource.data.correct + 1)));
      allow delete: if false;
    }

    match /rooms/{room} {

      match /doubts/{id} {
        allow read: if member();
        allow create: if member() && ownerOk(request.resource.data) && notBlocked(room, request.resource.data.authorId) && newPost('subject');
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && notBlocked(room, request.resource.data.authorId) && validPost('subject') && unchanged() && postEdit('subject');
        allow delete: if false;
      }
      match /ideas/{id} {
        allow read: if member();
        allow create: if member() && ownerOk(request.resource.data) && notBlocked(room, request.resource.data.authorId) && newPost('category');
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && notBlocked(room, request.resource.data.authorId) && validPost('category') && unchanged() && postEdit('category');
        allow delete: if false;
      }
      match /clubs/{id} {
        allow read: if member();
        allow create: if member() && ownerOk(request.resource.data) && notBlocked(room, request.resource.data.authorId) && newPost('club');
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && notBlocked(room, request.resource.data.authorId) && validPost('club') && unchanged() && postEdit('club');
        allow delete: if false;
      }
      match /gate/{id} {
        allow read: if member();
        allow create: if member() && ownerOk(request.resource.data) && notBlocked(room, request.resource.data.authorId) && newPost('subject');
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && notBlocked(room, request.resource.data.authorId) && validPost('subject') && unchanged() && postEdit('subject');
        allow delete: if false;
      }
      match /jobs/{id} {
        allow read: if member();
        allow create: if member() && ownerOk(request.resource.data) && notBlocked(room, request.resource.data.authorId) && newPost('type');
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && notBlocked(room, request.resource.data.authorId) && validPost('type') && unchanged() && postEdit('type');
        allow delete: if false;
      }
      // ---------- official notices: only admins post; everyone signed in can read ----------
      match /notices/{id} {
        function validNotice() {
          let d = request.resource.data;
          return d.keys().hasOnly(['title', 'body', 'from', 'link', 'pinned', 'expiresAt', 'createdAt', 'deleted'])
            && str(d.title, 3, 100) && str(d.body, 0, 600) && optStr(d, 'from', 40)
            && (!('link' in d) || d.link == '' || (d.link is string && d.link.matches('https://[^ ]{4,290}')))
            && optBool(d, 'pinned') && optBool(d, 'deleted')
            && (!('expiresAt' in d) || d.expiresAt is int) && d.createdAt is int;
        }
        allow read: if member();
        allow create, update: if (isAdmin() || isStaff(room)) && validNotice();
        allow delete: if isAdmin() || isStaff(room);
      }
      // ---------- welcome note: one short message from the college (principal, exam cell, placement cell) shown to every student ----------
      match /welcomeMsg/{id} {
        allow read: if member();
        allow create, update: if (isAdmin() || isStaff(room)) && id == 'current' && request.resource.data.keys().hasOnly(['text', 'from', 'active', 'updatedAt'])
          && str(request.resource.data.text, 3, 240) && optStr(request.resource.data, 'from', 40) && request.resource.data.active is bool && request.resource.data.updatedAt is int;
        allow delete: if false;
      }
      // ---------- club and campus events: admins/staff post them; students RSVP ----------
      match /events/{id} {
        function validEvent() {
          let d = request.resource.data;
          return d.keys().hasOnly(['title', 'club', 'venue', 'details', 'startAt', 'endAt', 'capacity', 'link', 'createdAt', 'deleted'])
            && str(d.title, 3, 100) && optStr(d, 'club', 40) && optStr(d, 'venue', 80) && optStr(d, 'details', 600)
            && d.startAt is int && (!('endAt' in d) || d.endAt is int)
            && (!('capacity' in d) || (d.capacity is int && d.capacity >= 0 && d.capacity <= 5000))
            && (!('link' in d) || d.link == '' || (d.link is string && d.link.matches('https://[^ ]{4,290}')))
            && d.createdAt is int && optBool(d, 'deleted');
        }
        allow read: if member();
        allow create, update: if (isAdmin() || isStaff(room)) && validEvent();
        allow delete: if isAdmin() || isStaff(room);
      }
      // RSVP: id is <eventId>_<uid>. Names are the public chosen names, so everyone signed in can see who is going.
      match /eventRsvp/{id} {
        allow read: if member();
        allow create, update: if member() && request.resource.data.keys().hasOnly(['eventId', 'uid', 'name', 'createdAt'])
          && request.resource.data.uid == request.auth.uid && id == request.resource.data.eventId + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(room)/events/$(request.resource.data.eventId))
          && str(request.resource.data.name, 1, 50) && request.resource.data.createdAt is int;
        allow delete: if isAdmin() || isStaff(room) || (signedIn() && resource.data.uid == request.auth.uid);
      }
      // ---------- weekly Plus leaderboard: each student writes only their own score row for the current week ----------
      match /weekly/{id} {
        function validWeekly() {
          let d = request.resource.data;
          return d.keys().hasOnly(['week', 'uid', 'name', 'points', 'mins', 'tests', 'createdAt', 'updatedAt'])
            && d.uid == request.auth.uid && id == d.week + '_' + request.auth.uid && d.week.matches('w[0-9]{3,6}')
            && str(d.name, 1, 30) && d.points is int && d.points >= 0 && d.points <= 3000
            && d.mins is int && d.mins >= 0 && d.mins <= 3000 && d.tests is int && d.tests >= 0 && d.tests <= 60
            && d.createdAt is int && d.createdAt > request.time.toMillis() - 691200000 && d.createdAt <= request.time.toMillis() + 86400000 && recent(d.updatedAt);
        }
        allow read: if member();
        allow create, update: if member() && validWeekly();
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
      // ---------- placement cell: campus drives posted by admins/staff, students register interest ----------
      match /drives/{id} {
        function validDrive() {
          let d = request.resource.data;
          return d.keys().hasOnly(['company', 'role', 'package', 'branches', 'minCgpa', 'lastDate', 'driveDate', 'link', 'details', 'createdAt', 'deleted'])
            && str(d.company, 2, 60) && str(d.role, 2, 80) && optStr(d, 'package', 40) && optStr(d, 'details', 800)
            && d.branches is list && d.branches.size() <= 12
            && (!('minCgpa' in d) || ((d.minCgpa is int || d.minCgpa is float) && d.minCgpa >= 0 && d.minCgpa <= 10))
            && d.lastDate is int && (!('driveDate' in d) || d.driveDate is int)
            && (!('link' in d) || d.link == '' || (d.link is string && d.link.matches('https://[^ ]{4,290}')))
            && d.createdAt is int && optBool(d, 'deleted');
        }
        allow read: if member();
        allow create, update: if (isAdmin() || isStaff(room)) && validDrive();
        allow delete: if isAdmin() || isStaff(room);
      }
      // A student's interest in a drive. The id is <driveId>_<their uid>. Placement staff and admins read them all; a student reads only their own.
      match /driveInterest/{id} {
        function validInterest() {
          let d = request.resource.data;
          return d.keys().hasOnly(['driveId', 'uid', 'name', 'branch', 'cgpa', 'phone', 'createdAt'])
            && d.uid == request.auth.uid && id == d.driveId + '_' + request.auth.uid
            && exists(/databases/$(database)/documents/rooms/$(room)/drives/$(d.driveId))
            && str(d.name, 1, 50) && optStr(d, 'branch', 24) && optStr(d, 'phone', 15)
            && (!('cgpa' in d) || ((d.cgpa is int || d.cgpa is float) && d.cgpa >= 0 && d.cgpa <= 10)) && d.createdAt is int;
        }
        allow read: if isAdmin() || isStaff(room) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if member() && validInterest();
        allow delete: if isAdmin() || isStaff(room) || (signedIn() && resource.data.uid == request.auth.uid);
      }
      // ---------- previous-year paper vault: only admins add papers (links to files), everyone signed in can read ----------
      match /papers/{id} {
        function validPaper() {
          let d = request.resource.data;
          return d.keys().hasOnly(['title', 'subject', 'year', 'exam', 'link', 'solution', 'note', 'createdAt', 'deleted'])
            && str(d.title, 3, 120) && str(d.subject, 2, 40) && d.year is int && d.year >= 1990 && d.year <= 2100
            && d.exam in ['Mid', 'End', 'Supplementary', 'Model', 'Other']
            && d.link is string && d.link.matches('https://[^ ]{4,290}')
            && (!('solution' in d) || d.solution == '' || (d.solution is string && d.solution.matches('https://[^ ]{4,290}')))
            && optStr(d, 'note', 200) && d.createdAt is int && optBool(d, 'deleted');
        }
        allow read: if member();
        allow create, update: if (isAdmin() || isStaff(room)) && validPaper();
        allow delete: if isAdmin() || isStaff(room);
      }
      // ---------- profile photos and 24-hour stories ----------
      match /profiles/{id} {
        function validProfile() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'dp', 'status', 'verified', 'plus', 'streak', 'curio', 'cid', 'handle', 'updatedAt', 'ownerUid']) && optStr(d, 'ownerUid', 60) && (d.get('verified', false) == false || request.auth.token.email_verified == true) && str(d.name, 1, 40) && optStr(d, 'status', 60) && optBool(d, 'verified') && optBool(d, 'plus') && (!('streak' in d) || (d.streak is int && d.streak >= 0 && d.streak <= 3650)) && (!('curio' in d) || (d.curio is int && d.curio >= 0 && d.curio <= 100000))
            && (!('cid' in d) || (d.cid is string && d.cid.size() <= 16 && exists(/databases/$(database)/documents/studentIds/$(request.auth.uid)) && get(/databases/$(database)/documents/studentIds/$(request.auth.uid)).data.id == d.cid))
            && (!('handle' in d) || (d.handle is string && d.handle.matches('[a-z0-9_]{3,15}') && exists(/databases/$(database)/documents/handles/$(d.handle)) && get(/databases/$(database)/documents/handles/$(d.handle)).data.uid == request.auth.uid)) && (d.get('plus', false) == false || plusActive(request.auth.uid)) && (d.get('verified', false) == false || request.auth.token.email_verified == true) && d.updatedAt is int
            && d.dp is string && d.dp.size() <= 40000 && (d.dp == '' || d.dp.matches('data:image/jpeg;base64,.*'));
        }
        allow read: if member();
        // Only the person who created a profile may change it. Older profiles without an owner can be claimed once by whoever saves them next.
        allow create, update: if member() && notBlocked(room, id) && validProfile() && str(id, 8, 80)
          && request.resource.data.get('ownerUid', '') == request.auth.uid
          && (resource == null || resource.data.get('ownerUid', '') in ['', request.auth.uid]);
        allow delete: if false;
      }
      // Reports against a profile photo or status line. One report per reporter, person and item. Only admins and staff read them.
      match /profileReports/{id} {
        allow read: if isAdmin() || isStaff(room);
        allow create: if member() && request.resource.data.keys().hasOnly(['target', 'what', 'reason', 'reporter', 'name', 'text', 'createdAt'])
          && request.resource.data.reporter == request.auth.uid && request.resource.data.what in ['dp', 'status'] && request.resource.data.reason in ['a', 'b', 'p', 's']
          && str(request.resource.data.target, 8, 80) && optStr(request.resource.data, 'name', 40) && optStr(request.resource.data, 'text', 60)
          && recent(request.resource.data.createdAt) && id == request.resource.data.reporter + '_' + request.resource.data.target + '_' + request.resource.data.what;
        allow update: if false;
        allow delete: if isAdmin() || isStaff(room);
      }
      // An admin or staff member hides someone's photo and/or status for everyone. Students read it to know what to hide.
      match /profileHidden/{id} {
        allow read: if member();
        allow create, update: if (isAdmin() || isStaff(room)) && str(id, 8, 80) && request.resource.data.keys().hasOnly(['dp', 'status', 'by', 'at'])
          && optBool(request.resource.data, 'dp') && optBool(request.resource.data, 'status') && request.resource.data.at is int;
        allow delete: if isAdmin() || isStaff(room);
      }
      match /stories/{id} {
        function validStory() {
          let d = request.resource.data;
          return d.keys().hasOnly(['authorId', 'authorName', 'kind', 'pageId', 'text', 'bg', 'caption', 'opts', 'ans', 'expl', 'ref', 'createdAt', 'deleted', 'reports', 'ownerUid'])
            && optStr(d, 'ownerUid', 60)
            && str(d.authorId, 8, 80) && str(d.authorName, 1, 40) && d.kind in ['photo', 'text', 'quiz', 'idea', 'innovation', 'share'] && d.createdAt is int
            && (d.kind == 'photo' ? str(d.pageId, 1, 100) : str(d.text, 1, 200))
            && (d.kind != 'quiz' || (d.opts is list && d.opts.size() >= 2 && d.opts.size() <= 4 && d.ans is int && d.ans >= 0 && d.ans < d.opts.size()))
            && optList(d, 'opts', 4) && optStr(d, 'expl', 200) && optStr(d, 'ref', 120) && optStr(d, 'caption', 300) && optStr(d, 'bg', 3) && optBool(d, 'deleted') && optList(d, 'reports', 100);
        }
        allow read: if member();
        allow create: if member() && ownerOk(request.resource.data) && notBlocked(room, request.resource.data.authorId) && validStory() && recent(request.resource.data.createdAt)
          && request.resource.data.get('deleted', false) == false && !('reports' in request.resource.data);
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && validStory() && unchanged() && changes(['deleted', 'reports']);
        allow delete: if false;
      }
      match /storyAnswers/{id} {
        function validAnswer() {
          let d = request.resource.data;
          return d.keys().hasOnly(['storyId', 'uid', 'name', 'to', 'campus', 'pick', 'ok', 'createdAt'])
            && str(d.storyId, 1, 100) && str(d.uid, 8, 80) && str(d.name, 1, 40) && str(d.to, 8, 80) && optStr(d, 'campus', 30)
            && d.pick is int && d.pick >= 0 && d.pick <= 3 && d.ok is bool && recent(d.createdAt)
            && id == d.storyId + '_' + d.uid;
        }
        allow read: if member();
        allow create: if member() && notBlocked(room, request.resource.data.uid) && validAnswer();
        allow update, delete: if false;
      }
      match /storyViews/{id} {
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['storyId', 'uid', 'name', 'createdAt'])
          && str(request.resource.data.storyId, 1, 100) && str(request.resource.data.uid, 8, 80)
          && str(request.resource.data.name, 1, 40) && recent(request.resource.data.createdAt)
          && id == request.resource.data.storyId + '_' + request.resource.data.uid;
        allow update, delete: if false;
      }
      // Device block list. Only the Firebase console can write here (rules deny everyone else).
      match /blocked/{id} {
        allow read: if member();
        allow create, update: if (isAdmin() || isStaff(room)) && request.resource.data.keys().hasOnly(['reason', 'by', 'at'])
          && request.resource.data.get('reason', '') is string && request.resource.data.get('reason', '').size() <= 120;
        allow delete: if isAdmin() || isStaff(room);
      }
      match /challenges/{id} {
        allow read: if member();
        allow create: if member() && ownerOk(request.resource.data) && notBlocked(room, request.resource.data.authorId) && newPost('type');
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && notBlocked(room, request.resource.data.authorId) && validPost('type') && unchanged() && postEdit('type');
        allow delete: if false;
      }

      // ---------- replies (answers, thoughts, inquiries) ----------
      match /replies/{id} {
        // A doubt asked with "answers only for me" accepts public replies from its asker only; everyone else answers privately.
        function noPublicAnswerToPrivate() {
          let d = request.resource.data;
          return d.parentColl != 'doubts' || !exists(/databases/$(database)/documents/rooms/$(room)/doubts/$(d.parentId))
            || get(/databases/$(database)/documents/rooms/$(room)/doubts/$(d.parentId)).data.get('ansPrivate', false) != true
            || get(/databases/$(database)/documents/rooms/$(room)/doubts/$(d.parentId)).data.get('ownerUid', '') == request.auth.uid;
        }
        function validReply() {
          let d = request.resource.data;
          return d.keys().hasOnly(['parentId', 'parentColl', 'body', 'authorId', 'authorName', 'anonymous', 'createdAt',
                                   'pages', 'fileAttachments', 'deleted', 'reports', 'ownerUid', 'ai'])
            && optStr(d, 'ownerUid', 60) && optBool(d, 'ai') && str(d.body, 1, 5000) && str(d.authorName, 1, 40) && str(d.authorId, 8, 80)
            && d.parentColl in ['doubts', 'ideas', 'clubs', 'gate', 'challenges', 'jobs', 'market']
            && str(d.parentId, 1, 100) && d.createdAt is int
            && optBool(d, 'anonymous') && optBool(d, 'deleted')
            && optList(d, 'pages', 5) && optList(d, 'fileAttachments', 5) && optList(d, 'reports', 100);
        }
        allow read: if member();
        allow create: if member() && ownerOk(request.resource.data) && notBlocked(room, request.resource.data.authorId) && validReply() && recent(request.resource.data.createdAt)
          && request.resource.data.get('deleted', false) == false && !('reports' in request.resource.data)
          && noPublicAnswerToPrivate();
        // A reply can only be hidden (deleted) or reported after posting.
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && validReply() && unchanged() && changes(['deleted', 'reports']);
        allow delete: if false;
      }

      // ---------- private answers: only the asker and the answerer can read them ----------
      // A student can send a private answer to the OWNER of a doubt (checked against the doubt itself). Up to 2 photos are stored inside the document.
      match /privateAnswers/{id} {
        function validPrivate() {
          let d = request.resource.data;
          return d.keys().hasOnly(['doubtId', 'toUid', 'ownerUid', 'authorId', 'authorName', 'body', 'imgs', 'createdAt', 'anonymous', 'ai'])
            && optBool(d, 'ai')
            && str(d.doubtId, 1, 100) && str(d.toUid, 3, 80) && d.ownerUid == request.auth.uid && d.toUid != request.auth.uid
            && str(d.authorId, 8, 80) && str(d.authorName, 1, 40) && str(d.body, 0, 5000) && d.createdAt is int && optBool(d, 'anonymous')
            && (d.body.size() > 0 || ('imgs' in d && d.imgs.size() > 0))
            && (!('imgs' in d) || (d.imgs is list && d.imgs.size() <= 2
                && (d.imgs.size() < 1 || (d.imgs[0] is string && d.imgs[0].size() <= 350000 && d.imgs[0].matches('data:image/jpeg;base64,.*')))
                && (d.imgs.size() < 2 || (d.imgs[1] is string && d.imgs[1].size() <= 350000 && d.imgs[1].matches('data:image/jpeg;base64,.*')))))
            && exists(/databases/$(database)/documents/rooms/$(room)/doubts/$(d.doubtId))
            && get(/databases/$(database)/documents/rooms/$(room)/doubts/$(d.doubtId)).data.get('ownerUid', '') == d.toUid;
        }
        allow read: if member() && (resource.data.ownerUid == request.auth.uid || resource.data.toUid == request.auth.uid);
        // One answer per helper per doubt (the id says so), so nobody can flood an asker.
        allow create: if member() && notBlocked(room, request.resource.data.authorId) && validPrivate() && recent(request.resource.data.createdAt)
          && id == request.resource.data.doubtId + '_' + request.auth.uid;
        // The asker can rate an answer. Nothing else can change.
        allow update: if member() && request.auth.uid == resource.data.toUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating']) && request.resource.data.rating in ['helpful', 'best'];
        allow delete: if false;
      }

      // ---------- teacher / senior verification of a public answer (staff or admin only) ----------
      match /verified/{id} {
        allow read: if member();
        allow create: if (isStaff(room) || isAdmin()) && request.resource.data.keys().hasOnly(['replyId', 'doubtId', 'by', 'byName', 'at'])
          && id == request.resource.data.replyId && str(request.resource.data.doubtId, 1, 100) && request.resource.data.by == request.auth.uid
          && str(request.resource.data.byName, 1, 40) && request.resource.data.at is int && recent(request.resource.data.at)
          && exists(/databases/$(database)/documents/rooms/$(room)/replies/$(id));
        allow update: if false;
        allow delete: if isStaff(room) || isAdmin();
      }

      // ---------- thanks: the asker credits a private answer (public, so the helper earns points and a notification) ----------
      match /thanks/{id} {
        function validThanks() {
          let d = request.resource.data;
          return d.keys().hasOnly(['doubtId', 'toUid', 'toAuthorId', 'toName', 'level', 'byUid', 'createdAt'])
            && str(d.doubtId, 1, 100) && str(d.toUid, 3, 80) && str(d.toAuthorId, 8, 80) && str(d.toName, 1, 40) && d.level in ['helpful', 'best']
            && d.byUid == request.auth.uid && d.createdAt is int && id == d.doubtId + '_' + d.toUid
            && get(/databases/$(database)/documents/rooms/$(room)/doubts/$(d.doubtId)).data.get('ownerUid', '') == request.auth.uid
            && exists(/databases/$(database)/documents/rooms/$(room)/privateAnswers/$(id))
            && get(/databases/$(database)/documents/rooms/$(room)/privateAnswers/$(id)).data.ownerUid == d.toUid;
        }
        allow read: if member();
        allow create: if member() && validThanks() && recent(request.resource.data.createdAt);
        allow update: if member() && validThanks() && resource.data.level == 'helpful' && request.resource.data.level == 'best'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['level', 'createdAt']);
        allow delete: if false;
      }

      // ---------- notebook pages (compressed photos and handwriting) ----------
      match /pages/{id} {
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['data', 'parentId', 'createdAt'])
          && str(request.resource.data.data, 30, 750000)
          && str(request.resource.data.parentId, 1, 100) && recent(request.resource.data.createdAt);
        allow update, delete: if false;
      }

      // ---------- likes, reactions, quiz answers, alumni approvals ----------
      // Document id must be <ideaId>_<uid>.
      match /likes/{id} {
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['ideaId', 'uid', 'createdAt', 'name'])
          && str(request.resource.data.uid, 8, 80) && str(request.resource.data.ideaId, 1, 200)
          && id == request.resource.data.ideaId + '_' + request.resource.data.uid
          && recent(request.resource.data.createdAt)
          && (!('name' in request.resource.data) || str(request.resource.data.name, 1, 40));
        allow delete: if member();
        allow update: if false;
      }

      // ---------- market ----------
      match /market/{id} {
        allow read: if member();
        allow create: if member() && ownerOk(request.resource.data) && notBlocked(room, request.resource.data.authorId) && validListing() && recent(request.resource.data.createdAt)
          && request.resource.data.get('deleted', false) == false && !('reports' in request.resource.data);
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && validListing() && unchanged()
          && changes(['title', 'body', 'category', 'price', 'condition', 'whatsapp', 'sold', 'deleted', 'reports']);
        allow delete: if false;
      }
      match /marketReports/{id} {
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['listingId', 'sellerId', 'reporterId', 'reason', 'createdAt'])
          && str(request.resource.data.listingId, 1, 100) && str(request.resource.data.sellerId, 8, 80)
          && str(request.resource.data.reporterId, 8, 80) && str(request.resource.data.reason, 1, 120)
          && recent(request.resource.data.createdAt);
        allow update, delete: if false;
      }
      match /marketRatings/{id} {
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['listingId', 'sellerId', 'raterId', 'score', 'createdAt'])
          && str(request.resource.data.listingId, 1, 100) && str(request.resource.data.sellerId, 8, 80)
          && str(request.resource.data.raterId, 8, 80)
          && request.resource.data.score is number && request.resource.data.score >= 1 && request.resource.data.score <= 5
          && recent(request.resource.data.createdAt);
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && changes(['score'])
          && request.resource.data.score is number && request.resource.data.score >= 1 && request.resource.data.score <= 5;
        allow delete: if false;
      }
      match /marketInterests/{id} {
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['listingId', 'sellerId', 'buyerId', 'buyerName', 'buyerCampus', 'createdAt'])
          && str(request.resource.data.listingId, 1, 100) && str(request.resource.data.sellerId, 8, 80)
          && str(request.resource.data.buyerId, 8, 80) && str(request.resource.data.buyerName, 1, 40)
          && request.resource.data.get('buyerCampus', '') is string && request.resource.data.get('buyerCampus', '').size() <= 30
          && recent(request.resource.data.createdAt);
        allow update: if adminMod() || staffMod(room) || reportOnly() || member() && isOwner() && sameOwner() && changes(['deleted']) && request.resource.data.deleted is bool;
        allow delete: if false;
      }

      // ---------- challenge scores (document id is <challengeId>_<uid>) ----------
      match /chal_scores/{id} {
        allow read: if member();
        allow create, update: if member()
          && request.resource.data.keys().hasOnly(['challengeId', 'userId', 'userName', 'score', 'timeTaken', 'answers', 'submittedAt'])
          && str(request.resource.data.challengeId, 1, 100) && str(request.resource.data.userId, 8, 80)
          && id == request.resource.data.challengeId + '_' + request.resource.data.userId
          && str(request.resource.data.userName, 1, 40)
          && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 1000
          && request.resource.data.timeTaken is number && request.resource.data.timeTaken >= 0
          && request.resource.data.answers is list && request.resource.data.answers.size() <= 10
          && recent(request.resource.data.submittedAt);
        allow delete: if false;
      }
    }
  }
}
